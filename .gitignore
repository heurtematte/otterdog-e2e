# --- secrets: never commit them (env files with tokens, App keys, webhook secrets) ---
.env
.env.*
!.env.example
.env.e2e*
*.pem
*.key
*.webhook-secret
secrets/

# --- harness outputs ---
# run artifacts (redacted text only, but still per-run data) and any local harness cache
artifacts/
.cache/
# the documentation site built by `make docs` (MkDocs)
site/

# --- agents: local Claude Code settings and agent worktrees (the skills of .claude/skills/ are tracked) ---
.claude/settings.local.json
.claude/worktrees/

# --- Python tooling ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# poetry.toml stays tracked: it only sets the in-project virtualenv (.venv) used by the Makefile and the workflows
