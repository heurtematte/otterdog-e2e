# otterdog-e2e environment file template. It holds NO values: copy it, uncomment what you need and fill it in.
#
# Where the harness looks (first file wins, the process environment always wins over every file):
#   1. ~/.config/otterdog-e2e/<target>.env      recommended: outside the repository, chmod 600
#   2. <project>/.env.e2e.<target>              git-ignored
#   3. <project>/.env.e2e                       git-ignored, shared by every target
# Syntax: KEY and an equals sign, then the value. '#' starts a comment, values may be single or double quoted
# (multi-line PEMs in double quotes), there is NO ${...} interpolation. These files are read when a live session
# loads its target (otterdog-e2e run/pr with a target, doctor, bootstrap, janitor, relay, app-manifest). Never
# commit a filled copy: .gitignore excludes .env, .env.* (except this file) and .env.e2e*.
#
# Every identity MUST be a dedicated machine account that belongs only to test organizations (the harness checks
# GET /user/orgs and pending memberships for classic PATs, the token's resource owner for fine-grained PATs). Two
# roles never share a token (only oracle may reuse the admin one).
# A secret is redacted and stripped from child processes only when its variable name ends with _TOKEN, _SECRET,
# _PASSWORD, _TOTP_SEED or _PRIVATE_KEY: keep these names.

# --- organization (targets/<name>.yaml: github.*) -------------------------------------------------------------
# exact-case login of the dedicated test organization
# E2E_ORG=
# numeric organization id (curl -s https://api.github.com/orgs/<org> | jq .id): pins the org, REQUIRED
# E2E_ORG_ID=
# optional comma separated ids of OTHER test orgs the machine accounts may belong to (the pinned id is always
# allowed), e.g. when the same accounts serve the free and the enterprise targets
# E2E_ALLOWED_ORG_IDS=

# --- repositories and template (config.*) ---------------------------------------------------------------------
# repo holding otterdog.json for the webapp plus the org lease and run ledger refs (default otterdog-e2e-configs)
# E2E_CONFIGS_REPO=
# org config repo of the webapp flows: auto (default) = one e2e-<run>-config repo per session, or a fixed name
# E2E_ORG_CONFIG_REPO=
# public repo receiving templates published for SUTs that are not releases (default otterdog-e2e-defaults)
# E2E_DEFAULTS_REPO=
# auto (default) | upstream | publish | url
# E2E_TEMPLATE_MODE=
# with mode url: https base template URL, pinned to a 40-hex commit after the @
# E2E_TEMPLATE_URL=

# --- identities (identities.*): logins are public, tokens are secrets -----------------------------------------
# Token kinds: each role below takes a classic PAT (ghp_...) or, where classic PATs are forbidden (enterprise
# policy), a FINE-GRAINED PAT (github_pat_...) with resource owner = the test org, Repository access = All
# repositories and the permissions of docs/setup-free-org.md#fine-grained-personal-access-tokens (an org owner may
# have to approve it). The outsider is the exception: it needs a classic PAT (leave it unset otherwise).
# E2E_<ROLE>_TOKEN_TYPE = auto (default) | classic | fine-grained declares the kind; doctor and every live session
# fail when the token is of another kind. Roles: ADMIN, ORACLE, AUTHOR, APPROVER, OUTSIDER (classic only),
# CONFIG_READ (the config_reader).
# E2E_ADMIN_TOKEN_TYPE=
# E2E_ORACLE_TOKEN_TYPE=
# E2E_AUTHOR_TOKEN_TYPE=
# E2E_APPROVER_TOKEN_TYPE=
# E2E_OUTSIDER_TOKEN_TYPE=
# E2E_CONFIG_READ_TOKEN_TYPE=
# admin, REQUIRED: org owner. Classic PAT with exactly repo, workflow, admin:org, admin:org_hook, delete_repo
# (read:org is implied by admin:org; read:user and user:email are tolerated, any other scope is refused), or a
# fine-grained PAT (owner permissions table of the setup guide; otterdog check-token-permissions then reports every
# classic scope missing: known issue KB-078).
# E2E_ADMIN_LOGIN=
# E2E_ADMIN_TOKEN=
# oracle, optional (falls back to admin): an org OWNER used for read-only ground-truth checks. Classic PAT with
# admin-allowed scopes only (repo, admin:org, admin:org_hook), or a fine-grained PAT (read-only owner table).
# E2E_ORACLE_LOGIN=
# E2E_ORACLE_TOKEN=
# author, optional: org member in the contributors team only (opens config PRs). Classic PAT: public_repo, read:org,
# or a fine-grained PAT (author table).
# E2E_AUTHOR_LOGIN=
# E2E_AUTHOR_TOKEN=
# approver, optional: member of the approval team (approves config PRs). Classic PAT: public_repo, read:org, or a
# fine-grained PAT (approver table).
# E2E_APPROVER_LOGIN=
# E2E_APPROVER_TOKEN=
# outsider, optional: NOT an org member. Classic PAT ONLY: public_repo, read:org (a fine-grained token cannot write
# to an org its account does not belong to, so it is refused).
# E2E_OUTSIDER_LOGIN=
# E2E_OUTSIDER_TOKEN=
# config_reader, optional (required for webapp tests of untrusted SUTs): FINE-GRAINED token of its own account,
# repository access "Public repositories" (read-only); becomes the webapp's OTTERDOG_CONFIG_TOKEN.
# E2E_CONFIG_READER_LOGIN=
# E2E_CONFIG_READ_TOKEN=
# Every classic PAT needs read:org (directly or through admin:org): GET /user/orgs answers 403 without it.

# --- GitHub App of the webapp tiers (app.*): written by `otterdog-e2e app-manifest` ---------------------------
# E2E_APP_ID=
# E2E_APP_SLUG=
# path of the PEM private key (0600), or the PEM itself in E2E_APP_PRIVATE_KEY (literal \n are accepted)
# E2E_APP_PRIVATE_KEY_FILE=
# E2E_APP_PRIVATE_KEY=
# webhook secret of the App (the relay signs the forwarded deliveries with it)
# E2E_APP_WEBHOOK_SECRET=

# --- teams (teams.*): names must be slugs [a-z0-9-] -----------------------------------------------------------
# defaults: otterdog-admins, project-leads, e2e-contributors
# E2E_ADMIN_TEAM=
# E2E_APPROVAL_TEAM=
# E2E_CONTRIBUTORS_TEAM=

# --- webapp (webapp.*) ------------------------------------------------------------------------------------------
# relay (default: compose stack + pull relay) | external (a webapp you run, e.g. kubectl port-forward) | none
# E2E_TRANSPORT=
# with transport external: loopback base URL of the webapp, and its /internal/init URL
# E2E_EXTERNAL_URL=
# E2E_EXTERNAL_INIT_URL=
# commit status contexts (defaults e2e/otterdog-validate and e2e/otterdog-sync; they must differ)
# E2E_VALIDATION_CONTEXT=
# E2E_SYNC_CONTEXT=
# hypercorn workers (default 1) and the loopback port of the compose stack (default 5000)
# E2E_WEBAPP_WORKERS=
# E2E_WEBAPP_PORT=

# --- web-UI tier (docs/web-ui-testing.md): the admin bot's web login --------------------------------------------
# Used only when the web-UI tier is allowed (--e2e-allow-web-ui or E2E_ALLOW_WEB_UI) and the SUT is trusted; never
# put them into an environment of untrusted lanes. The admin machine account needs two-factor authentication with
# an authenticator app (TOTP) and no SAML SSO. Declared names: identities.admin.username_env/password_env/totp_seed_env.
# username typed on github.com/login (optional, default E2E_ADMIN_LOGIN; may be the account's email)
# E2E_ADMIN_USERNAME=
# E2E_ADMIN_PASSWORD=
# base32 setup key of the authenticator app (or its otpauth:// URI), NOT a 6-digit code
# E2E_ADMIN_TOTP_SEED=
# seconds between the end of a web command and the next web login (default 32, never below one TOTP window, 30)
# E2E_WEB_LOGIN_SPACING=

# --- session tuning, read after the env files of a live session were loaded -----------------------------------
# seconds to wait for an org lease held by another session (default 0: fail fast)
# E2E_LEASE_WAIT=
# holder text written into the public lease commit (default local:<user> or the CI run URL)
# E2E_LEASE_HOLDER=
# live items are skipped when an identity has less core rate budget left (default 800)
# E2E_MIN_RATE_REMAINING=

# --- process options: NOT read from these files ----------------------------------------------------------------
# They are read when the command starts, before any env file: export them in your shell or use the CLI flags.
#   E2E_TARGET E2E_SUT E2E_BASE_SUT E2E_RESET_SUT E2E_TAGS E2E_SCENARIO E2E_RUN_ID E2E_WEBAPP_IMAGE E2E_PR_MANIFEST
#   (fallbacks of the --e2e-* pytest options), E2E_CACHE_DIR (default ~/.cache/otterdog-e2e), E2E_ARTIFACTS
#   (default <project>/artifacts), E2E_OTTERDOG_REPO (default eclipse-csi/otterdog), E2E_PROJECT_ROOT, E2E_LANE,
#   E2E_DOCKER_BUILD_ARGS (extra docker build arguments of SUT images)
#   E2E_ALLOW_WEB_UI (fallback of --e2e-allow-web-ui: 1/true enables the web-UI tier), E2E_WEB_LOGIN (1: the
#   web-login test opens a visible browser, local runs with a display only), E2E_WEB_READER (show-live or import:
#   how the trusted reader of the web-UI tier reads the web-only settings)
